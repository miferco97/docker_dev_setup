#!/bin/bash

# CLI util for runing docker compose from anywhere

# autocompletion

get_compose_file() {
  project_dir=$1
  # if there is a folder named .devenv in the project directory, use the docker-compose-devenv.yml file
  if [ -f $project_dir/.devenv/docker-compose-devenv.yml ]; then
      echo "$project_dir/.devenv/docker-compose-devenv.yml"
    else
      echo "$project_dir/docker-compose.yml"
    fi

}

generate_env_folder() {
  project_dir=$1
  if [ ! -d $project_dir/.devenv ]; then
    mkdir $project_dir/.devenv
    echo "Created .devenv folder in $project_dir"
  fi
  if [ ! -d $project_dir/.claude_local ]; then
    mkdir $project_dir/.claude_local
    echo "Created .claude_local folder in $project_dir"
  fi
  project_name=$(basename $project_dir)
  if [ ! -d $HOME/.claude/projects/dev-env-$project_name ]; then
    mkdir -p $HOME/.claude/projects/dev-env-$project_name
    echo "Created ~/.claude/projects/dev-env-$project_name folder"
  fi
  python3 $PROJECTS_DIR/.dev_env_image/extend_docker_compose.py $project_dir/docker-compose.yml -d $PROJECTS_DIR/.dev_env_image/devenv_compose.yml -o $project_dir/.devenv/docker-compose-devenv.yml
}

usage() {
  echo ""
  echo "  ____             _                _____            "
  echo " |  _ \\  ___   ___| | _____ _ __   | ____|_ ____   __"
  echo " | | | |/ _ \\ / __| |/ / _ \\ '__|  |  _| | '_ \\ \\ / /"
  echo " | |_| | (_) | (__|   <  __/ |     | |___| | | \\ V / "
  echo " |____/ \\___/ \\___|_|\\_\\___|_|     |_____|_| |_|\\_/  "
  echo ""
  echo " A CLI tool for managing Docker-based development environments."
  echo " Easily build, run, and attach to project containers from anywhere."
  echo ""
  echo " Author: Miguel Fernandez Cortizas (github.com/miferco97)"
  echo " License: MIT - $(date +%Y)"
  echo ""
  echo "Usage: docker-env [command]"
  echo "Commands:"
  echo "  up <project_name> - Start the project"
  echo "  down <project_name> - Stop the project"
  echo "  restart <project_name> - Restart the project"
  echo "  build <project_name> [-v] [--no-cache] - Build the project"
  echo "  setup <project_name> - Setup the project"
  echo "  list [-r|--running] [-p|--plain] - List all projects"
  echo "  -h, --help - Show this help"
  exit 1
}

# find the path of the executable script
SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
PROJECTS_DIR=$(dirname "$SCRIPT_DIR")

# list all projects
# projects are directories in the same directory as the script without the bin directory and occluded files

list_projects() {
  MODE=""
  for arg in "$@"; do
    case $arg in
      -r|--running) MODE="running" ;;
      -p|--plain) MODE="plain" ;;
      -h|--help)
        echo "Usage: docker-env list [-r|--running] [-p|--plain]"
        echo "List all projects."
        echo "Options:"
        echo "  -r, --running  Show only running projects"
        echo "  -p, --plain    Show only project names (plain)"
        echo "  -h, --help  Show this help"
        exit 0
        ;;
    esac
  done

  folders=$(find $PROJECTS_DIR -maxdepth 1  -type d -not -name ".*" -not -name "bin" -wholename "$PROJECTS_DIR/*")
  # sorting the folders by name
  folders=$(echo $folders | tr ' ' '\n' | sort | tr '\n' ' ')
  lines_to_echo=""
  lines_to_echo_running=""
  for folder in $folders; do
    container=$(grep container_name $(get_compose_file $folder) | awk '{print $2}')

    running=$(docker ps -q -f name=$container)

    if [ "$MODE" == "plain" ]; then
      lines_to_echo+=$(basename $folder)" "
    elif [ "$MODE" == "running" ]; then
      if [ ! -z $running ]; then
        lines_to_echo+=$(basename $folder)" "
      fi
    else
      if [ ! -z $running ]; then
        lines_to_echo_running+=$(basename $folder)" "
      else
        lines_to_echo+=$(basename $folder)" "
      fi
    fi
  done
  #sort both lines
  lines_to_echo_running=$(echo $lines_to_echo_running | tr ' ' '\n' | sort | tr '\n' ' ')
  lines_to_echo=$(echo $lines_to_echo | tr ' ' '\n' | sort | tr '\n' ' ')

  # echo the lines running in yellow
  # echo the lines not running in white
  for line in $lines_to_echo_running; do
      echo -e "\033[33m$line [running]\033[0m"
  done
  for line in $lines_to_echo; do
      echo -e $line
  done

}

search_project() {
  project=$1
  if [ -z $project ]; then
    echo "Project name is required"
    exit 1
  fi
  list=$(list_projects -p)
  for item in $list; do
    if [ $item == $project ]; then
      return 0
    fi
  done
  return 1
}


# check if the first argument is a valid project
if [ $# -lt 1 ]; then
  usage
fi

# check if the first argument is a valid command
# if not, show usage
# if it is, run the command

check_is_running() {
  project=$1
  search_project $project
  if [ $? -eq 0 ]; then
    container=$(grep container_name $(get_compose_file $PROJECTS_DIR/$project) | awk '{print $2}')
    running=$(docker ps -q -f name=$container)
    if [ -z $running ]; then
      return 1
    else
      return 0
    fi
  else
    echo "Project not found"
    exit 1
  fi
}


up() {
  project=""
  for arg in "$@"; do
    case $arg in
      -h|--help)
        echo "Usage: docker-env up <project_name>"
        echo "Start the project and attach to its container."
        echo "Options:"
        echo "  -h, --help  Show this help"
        exit 0
        ;;
      *) project=$arg ;;
    esac
  done
  if [ -z "$project" ]; then
    echo "Usage: docker-env up <project_name>"
    exit 1
  fi
  search_project $project
  if [ $? -eq 0 ]; then
    if check_is_running $project; then
      echo "Project is already running"
    else
      echo "Starting project $project"
        echo "Generating .devenv/docker-compose-devenv.yml file"
        generate_env_folder $PROJECTS_DIR/$project
        if [ $? -ne 0 ]; then
          echo "Failed to generate .devenv/docker-compose-devenv.yml file"
          exit 1
        fi
      # check if the project is already running
      # if it is, show a message
      # if not, start the project
      docker compose -f $(get_compose_file $PROJECTS_DIR/$project) up -d
      xhost +local:docker
      xhost +local:root
    fi
    #parse the container name from the docker-compose file
    container=$(grep container_name $PROJECTS_DIR/$project/docker-compose.yml | awk '{print $2}')
    docker exec -it $container /bin/bash
  else
    echo "Project not found"
  fi
}

down() {
  project=""
  for arg in "$@"; do
    case $arg in
      -h|--help)
        echo "Usage: docker-env down <project_name>"
        echo "Stop the project container."
        echo "Options:"
        echo "  -h, --help  Show this help"
        exit 0
        ;;
      *) project=$arg ;;
    esac
  done
  if [ -z "$project" ]; then
    echo "Usage: docker-env down <project_name>"
    exit 1
  fi
  search_project $project
  if [ $? -eq 0 ]; then
    compose_file=$(get_compose_file $PROJECTS_DIR/$project)
    echo "Stopping project $project using compose file $compose_file"
    docker compose -f $compose_file down
  else
    echo "Project not found"
  fi
  # check if there is any other container running
  # if not, stop xhost 
  RUNNING=$(docker ps -q)
  if [ -z $RUNNING ]; then
    xhost -local:docker
    xhost -local:root
    echo "No other containers running, stopping xhost"
  fi
}

restart() {
  project=""
  for arg in "$@"; do
    case $arg in
      -h|--help)
        echo "Usage: docker-env restart <project_name>"
        echo "Restart the project container."
        echo "Options:"
        echo "  -h, --help  Show this help"
        exit 0
        ;;
      *) project=$arg ;;
    esac
  done
  if [ -z "$project" ]; then
    echo "Usage: docker-env restart <project_name>"
    exit 1
  fi
  search_project $project
  if [ $? -eq 0 ]; then
    docker compose -f $(get_compose_file $PROJECTS_DIR/$project) restart
  else
    echo "Project not found"
  fi


}

build() {
  PROGRESS=""
  NO_CACHE=""
  project=""
  for arg in "$@"; do
    case $arg in
      -v) PROGRESS="--progress=plain" ;;
      --no-cache) NO_CACHE="--no-cache" ;;
      -h|--help)
        echo "Usage: docker-env build <project_name> [-v] [--no-cache]"
        echo "Options:"
        echo "  -v              Show verbose build output"
        echo "  --no-cache      Build without using Docker cache"
        echo "  -h, --help      Show this help"
        exit 0
        ;;
      *) project=$arg ;;
    esac
  done
  if [ -z "$project" ]; then
    echo "Usage: docker-env build <project_name> [-v] [--no-cache]"
    exit 1
  fi
  search_project $project
  if [ $? -eq 0 ]; then
    echo "Building project $project"
      echo "Generating .devenv/docker-compose-devenv.yml file"
      generate_env_folder $PROJECTS_DIR/$project
      if [ $? -ne 0 ]; then
        echo "Failed to generate .devenv/docker-compose-devenv.yml file"
        exit 1
      fi
    docker compose -f $(get_compose_file $PROJECTS_DIR/$project) build $PROGRESS $NO_CACHE
  else
    echo "Project not found"
  fi
}


setup() {
  project=""
  for arg in "$@"; do
    case $arg in
      -h|--help)
        echo "Usage: docker-env setup <project_name>"
        echo "Build and start the project."
        echo "Options:"
        echo "  -h, --help  Show this help"
        exit 0
        ;;
      *) project=$arg ;;
    esac
  done
  if [ -z "$project" ]; then
    echo "Usage: docker-env setup <project_name>"
    exit 1
  fi
  search_project $project
  if [ $? -eq 0 ]; then
    docker compose -f $PROJECTS_DIR/$project/docker-compose.yml up -d --build
    xhost +
  else
    echo "Project not found"
  fi
}

case $1 in
  up)
    up "${@:2}"
    ;;
  down)
    down "${@:2}"
    ;;
  restart)
    restart "${@:2}"
    ;;
  build)
    build "${@:2}"
    ;;
  list)
    list_projects "${@:2}"
    ;;
  setup)
    setup "${@:2}"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage
    ;;
esac

exit 0



